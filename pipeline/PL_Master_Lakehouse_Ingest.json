{
	"name": "PL_Master_Lakehouse_Ingest",
	"properties": {
		"description": "Metadata-driven ingestion: control table -> ForEach active source -> Landing, then Databricks Bronze -> Silver -> Gold. Failures are logged to dbo.pipeline_audit_log and re-raised.",
		"activities": [
			{
				"name": "Set_Effective_Run_Date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "effective_run_date",
					"value": {
						"value": "@if(empty(pipeline().parameters.run_date), formatDateTime(utcnow(), 'yyyy-MM-dd'), pipeline().parameters.run_date)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Lookup_ActiveSources",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Set_Effective_Run_Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT source_name, source_type, load_type, source_object, file_format, watermark_column, last_watermark_value, target_folder FROM dbo.control_table WHERE is_active = 1",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Active_Source",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_ActiveSources",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_ActiveSources').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 3,
					"activities": [
						{
							"name": "If_Source_Is_SQL",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(toUpper(item().source_type), 'SQL')",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Copy_Files_To_Landing",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 2,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"wildcardFolderPath": {
														"value": "@concat(item().source_object, '/', formatDateTime(variables('effective_run_date'), 'yyyy/MM/dd'))",
														"type": "Expression"
													},
													"wildcardFileName": "*",
													"deleteFilesAfterCompletion": false
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings",
													"copyBehavior": "PreserveHierarchy"
												}
											},
											"enableStaging": false
										}
									},
									{
										"name": "Log_Success_File_Source",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy_Files_To_Landing",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_log_pipeline_event]",
											"storedProcedureParameters": {
												"run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"pipeline_name": {
													"value": {
														"value": "@pipeline().Pipeline",
														"type": "Expression"
													},
													"type": "String"
												},
												"activity_name": {
													"value": "Copy_Files_To_Landing",
													"type": "String"
												},
												"batch_date": {
													"value": {
														"value": "@variables('effective_run_date')",
														"type": "Expression"
													},
													"type": "String"
												},
												"status": {
													"value": "SUCCESS",
													"type": "String"
												},
												"source_name": {
													"value": {
														"value": "@item().source_name",
														"type": "Expression"
													},
													"type": "String"
												},
												"rows_copied": {
													"value": {
														"value": "@activity('Copy_Files_To_Landing').output.filesWritten",
														"type": "Expression"
													},
													"type": "Int64"
												}
											}
										}
									},
									{
										"name": "Log_Failure_File_Copy",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy_Files_To_Landing",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_log_pipeline_event]",
											"storedProcedureParameters": {
												"run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"pipeline_name": {
													"value": {
														"value": "@pipeline().Pipeline",
														"type": "Expression"
													},
													"type": "String"
												},
												"activity_name": {
													"value": "Copy_Files_To_Landing",
													"type": "String"
												},
												"batch_date": {
													"value": {
														"value": "@variables('effective_run_date')",
														"type": "Expression"
													},
													"type": "String"
												},
												"status": {
													"value": "FAILED",
													"type": "String"
												},
												"source_name": {
													"value": {
														"value": "@item().source_name",
														"type": "Expression"
													},
													"type": "String"
												},
												"error_message": {
													"value": {
														"value": "@activity('Copy_Files_To_Landing').error.message",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										}
									},
									{
										"name": "Fail_File_Copy",
										"type": "Fail",
										"dependsOn": [
											{
												"activity": "Log_Failure_File_Copy",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('File copy failed for ', item().source_name)",
												"type": "Expression"
											},
											"errorCode": "ADF_SRC_FILE"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Lookup_NewWatermark",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat('SELECT ISNULL(CONVERT(varchar(23), MAX(', item().watermark_column, '), 121), ''', item().last_watermark_value, ''') AS NewWatermark FROM ', item().source_object)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"firstRowOnly": true
										}
									},
									{
										"name": "Copy_SQL_To_Landing",
										"type": "Copy",
										"dependsOn": [
											{
												"activity": "Lookup_NewWatermark",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 2,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat('SELECT * FROM ', item().source_object, ' WHERE ', item().watermark_column, ' > ''', item().last_watermark_value, ''' AND ', item().watermark_column, ' <= ''', activity('Lookup_NewWatermark').output.firstRow.NewWatermark, '''')",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false
										}
									},
									{
										"name": "SP_Update_Watermark",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy_SQL_To_Landing",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_update_watermark]",
											"storedProcedureParameters": {
												"source_name": {
													"value": {
														"value": "@item().source_name",
														"type": "Expression"
													},
													"type": "String"
												},
												"new_watermark": {
													"value": {
														"value": "@activity('Lookup_NewWatermark').output.firstRow.NewWatermark",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										}
									},
									{
										"name": "Log_Success_SQL_Source",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "SP_Update_Watermark",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_log_pipeline_event]",
											"storedProcedureParameters": {
												"run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"pipeline_name": {
													"value": {
														"value": "@pipeline().Pipeline",
														"type": "Expression"
													},
													"type": "String"
												},
												"activity_name": {
													"value": "Copy_SQL_To_Landing",
													"type": "String"
												},
												"batch_date": {
													"value": {
														"value": "@variables('effective_run_date')",
														"type": "Expression"
													},
													"type": "String"
												},
												"status": {
													"value": "SUCCESS",
													"type": "String"
												},
												"source_name": {
													"value": {
														"value": "@item().source_name",
														"type": "Expression"
													},
													"type": "String"
												},
												"rows_copied": {
													"value": {
														"value": "@activity('Copy_SQL_To_Landing').output.rowsCopied",
														"type": "Expression"
													},
													"type": "Int64"
												}
											}
										}
									},
									{
										"name": "Log_Failure_Lookup_Watermark",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Lookup_NewWatermark",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_log_pipeline_event]",
											"storedProcedureParameters": {
												"run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"pipeline_name": {
													"value": {
														"value": "@pipeline().Pipeline",
														"type": "Expression"
													},
													"type": "String"
												},
												"activity_name": {
													"value": "Lookup_NewWatermark",
													"type": "String"
												},
												"batch_date": {
													"value": {
														"value": "@variables('effective_run_date')",
														"type": "Expression"
													},
													"type": "String"
												},
												"status": {
													"value": "FAILED",
													"type": "String"
												},
												"source_name": {
													"value": {
														"value": "@item().source_name",
														"type": "Expression"
													},
													"type": "String"
												},
												"error_message": {
													"value": {
														"value": "@activity('Lookup_NewWatermark').error.message",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										}
									},
									{
										"name": "Log_Failure_SQL_Copy",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy_SQL_To_Landing",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "0.01:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_log_pipeline_event]",
											"storedProcedureParameters": {
												"run_id": {
													"value": {
														"value": "@pipeline().RunId",
														"type": "Expression"
													},
													"type": "String"
												},
												"pipeline_name": {
													"value": {
														"value": "@pipeline().Pipeline",
														"type": "Expression"
													},
													"type": "String"
												},
												"activity_name": {
													"value": "Copy_SQL_To_Landing",
													"type": "String"
												},
												"batch_date": {
													"value": {
														"value": "@variables('effective_run_date')",
														"type": "Expression"
													},
													"type": "String"
												},
												"status": {
													"value": "FAILED",
													"type": "String"
												},
												"source_name": {
													"value": {
														"value": "@item().source_name",
														"type": "Expression"
													},
													"type": "String"
												},
												"error_message": {
													"value": {
														"value": "@activity('Copy_SQL_To_Landing').error.message",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										}
									},
									{
										"name": "Log_Failure_Watermark_Update",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "SP_Update_Watermark",
												"dependencyConditions": [
