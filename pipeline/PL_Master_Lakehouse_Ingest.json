			{
				"name": "NB_Bronze_Ingest",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEach_Active_Source",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.04:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat(pipeline().parameters.notebook_base_path, '/01_bronze_ingest')",
						"type": "Expression"
					},
					"baseParameters": {
						"batch_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"run_date": {
							"value": "@variables('effective_run_date')",
							"type": "Expression"
						},
						"landing_container": {
							"value": "@pipeline().parameters.landing_container",
							"type": "Expression"
						}
					}
				}
			},
